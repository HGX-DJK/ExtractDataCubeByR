# ==============================================================================
# Git 忽略配置文件：多时相数据立方体作物识别项目
# ==============================================================================

# 1. 严格忽略 data/ 目录下的所有数据集、切片与真值样本数据
data/
data/**

# 2. 忽略大体量遥感栅格切片与地理空间二进制数据 (如 SDC30、Sentinel-2 影像等)
*.tif
*.tiff
*.TIF
*.TIFF
*.nc
*.hdf
*.h5
*.zip
*.tar.gz
*.7z

# 3. 忽略模型训练输出与制图中间结果
output/
output_*/
work_dir/
extracted_data/

# 4. 忽略 R 运行环境与 IDE 缓存
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.DS_Store


models/